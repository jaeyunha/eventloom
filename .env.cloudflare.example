# Copy this file to .env.cloudflare-staging and
# .env.cloudflare-production, then set each environment's real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
WEB_ORIGIN=https://web.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://web.example.com
API_UPSTREAM_ORIGIN=https://api.example.com

# API Worker secrets synchronized by cloudflare:secrets:<environment>.
# Keep staging and production values distinct.
BETTER_AUTH_SECRET=
OPENSEND_API_KEY=
OPENAI_API_KEY=
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_CREDENTIAL_ENCRYPTION_KEY=

# Generate one random value per environment with:
#   openssl rand -hex 32
# The sync script installs this same environment value on both API and web.
CACHE_INVALIDATION_TOKEN=

# Required for production custom-domain routing. Hostnames must match the origins above,
# and each hostname must belong to its operator-owned Cloudflare zone.
WEB_HOSTNAME=web.example.com
WEB_ZONE_NAME=example.com
API_HOSTNAME=api.example.com
API_ZONE_NAME=example.com

# Deployment-owned OpenSend endpoint and identities
OPENSEND_API_URL=https://mail.example.com
AUTH_FROM_EMAIL=login@example.com
SPEAKERS_FROM_EMAIL=program@example.com
CALENDAR_FROM_EMAIL=schedule@example.com
CALENDAR_UID_DOMAIN=calendar.example.com

# Optional organization-scoped Airtable OAuth. Hosted production keeps manual
# PAT connections disabled.
AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_PAT_CONNECTION_ENABLED=false

# Deployment-owned AI selection. Supported values: disabled or openai.
AI_PROVIDER=disabled

# Deployment-owned OpenAI model selection
OPENAI_MODEL=gpt-5.6-terra
OPENAI_AGENDA_MODEL=gpt-5.6-sol
OPENAI_EVALUATION_MODEL=gpt-5.6-sol
OPENAI_REMIX_MODEL=gpt-5.6-terra
