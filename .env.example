# Web and API
APP_ENV=local
WEB_ORIGIN=http://127.0.0.1:3015
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3015
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_ORGANIZATION_ID=ai-engineer
API_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787
ORGANIZER_AUTOJOIN_DOMAINS=swyx.io,ai.engineer
ORGANIZER_AUTOJOIN_ORGANIZATION_ID=ai-engineer

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
CLOUDFLARE_TOKEN_KIND=user
# Release preflight only: supply a separate API-token read credential.
CLOUDFLARE_API_AUDIT_TOKEN=
R2_BUCKET_NAME=open-sessionboard-files
QUEUE_NAME=open-sessionboard-jobs

# Airtable
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# OpenSend
OPENSEND_API_URL=https://opensend.namuh.co
OPENSEND_API_KEY=
AUTH_FROM_EMAIL=auth@sessionboard.namuh.co
SPEAKERS_FROM_EMAIL=speakers@sessionboard.namuh.co
CALENDAR_FROM_EMAIL=calendar@sessionboard.namuh.co

# Forge release privacy check (repository-read token only)
FORGE_API_URL=https://forge.smol.ai
FORGE_REPOSITORY=jaeyunha/open-sessionboard
FORGE_API_TOKEN=
