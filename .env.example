# Web and API
APP_ENV=local
WEB_ORIGIN=http://localhost:3015
NEXT_PUBLIC_APP_URL=http://localhost:3015
NEXT_PUBLIC_API_URL=http://localhost:8787
API_URL=http://localhost:8787
BETTER_AUTH_SECRET=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
CLOUDFLARE_TOKEN_KIND=user
# Release preflight only: supply a separate API-token read credential.
CLOUDFLARE_API_AUDIT_TOKEN=
R2_BUCKET_NAME=open-sessionboard-files
QUEUE_NAME=open-sessionboard-jobs

# Airtable
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# OpenSend
OPENSEND_API_URL=https://opensend.namuh.co
OPENSEND_API_KEY=
AUTH_FROM_EMAIL=auth@foreverbrowsing.com
SPEAKERS_FROM_EMAIL=speakers@foreverbrowsing.com
CALENDAR_FROM_EMAIL=calendar@foreverbrowsing.com

# OAuth (optional provider paths)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Accelevents (optional outbound publication)
ACCELEVENTS_API_BASE_URL=
ACCELEVENTS_API_KEY=

# Forge release privacy check (repository-read token only)
FORGE_API_URL=https://forge.smol.ai
FORGE_REPOSITORY=jaeyunha/open-sessionboard
FORGE_API_TOKEN=
