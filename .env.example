# Web and API
APP_ENV=local
RUNTIME_PROFILE=integrated
WEB_ORIGIN=http://127.0.0.1:3015
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_RUNTIME_PROFILE=integrated
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3015
API_UPSTREAM_ORIGIN=http://127.0.0.1:8787
API_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787
CACHE_INVALIDATION_TOKEN=local-cache-invalidation

# Advisory AI (backend only; never use NEXT_PUBLIC_* or committed Wrangler vars for secrets)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_AGENDA_MODEL=gpt-5.6-sol
OPENAI_EVALUATION_MODEL=gpt-5.6-sol
OPENAI_REMIX_MODEL=gpt-5.6-terra
OPENAI_AGENDA_REASONING_EFFORT=medium
OPENAI_EVALUATION_REASONING_EFFORT=medium
OPENAI_REMIX_REASONING_EFFORT=low

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Each deployed environment uses its own ignored environment file.
D1_DATABASE_ID=
WEB_ORIGIN=http://127.0.0.1:3015
API_URL=http://127.0.0.1:8787
# Required in .env.cloudflare-production for production custom-domain routing.
WEB_HOSTNAME=
WEB_ZONE_NAME=
API_HOSTNAME=
API_ZONE_NAME=
CLOUDFLARE_TOKEN_KIND=user
# Release preflight only: supply a separate API-token read credential.
CLOUDFLARE_API_AUDIT_TOKEN=
# Provisioned legacy names retained until the Eventloom infrastructure cutover.
R2_BUCKET_NAME=open-sessionboard-private-files-local
QUEUE_NAME=open-sessionboard-outbox-local

# Airtable
# Use a PAT restricted to the development base. Integrated local never reads AIRTABLE_BASE_ID.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_DEV_ID=
# Deployed staging/production secret inputs only:
AIRTABLE_BASE_ID=

# OpenSend and calendar identity (explicit safe local values; deployed values live in each .env.cloudflare-* file)
OPENSEND_API_URL=http://127.0.0.1:8026
OPENSEND_API_KEY=local-development
AUTH_FROM_EMAIL=login@local.example.test
SPEAKERS_FROM_EMAIL=program@local.example.test
CALENDAR_FROM_EMAIL=schedule@local.example.test
CALENDAR_UID_DOMAIN=calendar.local.example.test

# Forge release privacy check (repository-read token only)
FORGE_API_URL=https://forge.smol.ai
FORGE_REPOSITORY=jaeyunha/open-sessionboard
FORGE_API_TOKEN=
