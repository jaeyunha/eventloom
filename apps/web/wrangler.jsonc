{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-sessionboard-web-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "local",
    "NEXT_PUBLIC_APP_URL": "http://127.0.0.1:3015",
    "API_UPSTREAM_ORIGIN": "http://127.0.0.1:8787"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "open-sessionboard-web-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "open-sessionboard-web-cache-local"
    }
  ],
  "env": {
    "staging": {
      "name": "open-sessionboard-web-staging",
      "workers_dev": true,
      "observability": {
        "enabled": true
      },
      "vars": {
        "APP_ENV": "staging",
        // Generated deployment config replaces these operator-neutral placeholders.
        "NEXT_PUBLIC_APP_URL": "https://web-staging.example.invalid",
        "API_UPSTREAM_ORIGIN": "https://api-staging.example.invalid"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "open-sessionboard-web-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "open-sessionboard-web-cache-staging"
        }
      ]
    },
    "production": {
      "name": "open-sessionboard-web-production",
      "workers_dev": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "APP_ENV": "production",
        // Generated deployment config replaces these operator-neutral placeholders.
        "NEXT_PUBLIC_APP_URL": "https://web-production.example.invalid",
        "API_UPSTREAM_ORIGIN": "https://api-production.example.invalid"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "routes": [
        {
          "pattern": "web-production.example.invalid",
          "zone_name": "production.example.invalid",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "open-sessionboard-web-production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "open-sessionboard-web-cache-production"
        }
      ]
    }
  }
}
