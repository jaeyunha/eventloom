{
  "name": "open-sessionboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @open-sessionboard/contracts build && bun run --parallel --filter './apps/*' dev",
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fix": "biome check --write .",
    "postinstall": "bun run --filter @open-sessionboard/contracts build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
